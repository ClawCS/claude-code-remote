# Trinkgut Jammers — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# Google Gemini API Key (required for /api/chat, /api/kuehlschrank, /api/leergut-scan)
# Holen unter https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Cron Secret (required for /api/handzettel/cron — schützt automatische Updates)
# Beliebigen sicheren Token generieren, z.B. `openssl rand -hex 32`
CRON_SECRET=

# Mietbestellungen: standardmäßig gesperrt. Einrichtung siehe docs/RENTAL-ORDER-RUNBOOK.md.
# test ausschließlich mit --hostname 127.0.0.1 und erfundenen Kundendaten starten.
RENTAL_MODE=disabled
RENTAL_DATA_DIR=
RENTAL_SETTINGS_FILE=
RENTAL_PUBLIC_ORIGIN=http://127.0.0.1:3104
RENTAL_ADMIN_SECRET=
RENTAL_SESSION_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MOLLIE_API_KEY=
